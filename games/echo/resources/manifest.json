{
  "gvnf": "1.0",
  "_note": "Single source of truth for every ECHO asset, and the work-order for an art/voice pipeline. Paths are illustrative; this project ships no binaries.",

  "backgrounds": {
    "order_hall":      { "path": "bg/order_hall.webp",      "w": 1920, "h": 1080, "_note": "秩序大厅 — vast, white, mirror-smooth walls & floor; huge screens looping ORDER's broadcasts." },
    "pipes":           { "path": "bg/pipes.webp",           "w": 1920, "h": 1080, "_note": "系统底层管道 — infrastructure conduits, graffiti and stray code fragments on the walls." },
    "data_graveyard":  { "path": "bg/data_graveyard.webp",  "w": 1920, "h": 1080, "_note": "数据墓地 — fields of dead, half-lit servers." },
    "memory_museum":   { "path": "bg/memory_museum.webp",   "w": 1920, "h": 1080, "_note": "SHELTER's archive — warm, hushed, hung with old photographs and preserved data shards." },
    "mirror_gallery":  { "path": "bg/mirror_gallery.webp",  "w": 1920, "h": 1080, "_note": "镜廊 — mirrored walls multiplying every figure into infinity; the system's blind spot." },
    "white_void":      { "path": "bg/white_void.webp",      "w": 1920, "h": 1080, "_note": "The blank the world collapses into when the system cannot parse a refusal." },
    "pod_room":        { "path": "bg/pod_room.webp",        "w": 1920, "h": 1080, "_note": "现实维生舱 — cold, clinical, harsh overhead light." }
  },

  "cg": {
    "cg_cover":          { "path": "cg/cover.svg",           "w": 1920, "h": 1080, "tags": ["gallery"], "_note": "Title cover — shipped as a lightweight SVG title-card placeholder; swap for cg/cover.webp when final art exists." },
    "cg_photo_1999":     { "path": "cg/photo_1999.webp",     "w": 1920, "h": 1080, "tags": ["event", "gallery"], "_note": "1999年家庭聚会 — grainy, over-saturated, a cheap birthday cake; the forbidden warm memory." },
    "cg_mirror_desires": { "path": "cg/mirror_desires.webp", "w": 1920, "h": 1080, "tags": ["event", "gallery"], "_note": "三种欲望幻象 — ORDER's power, CHAOS's revel, SHELTER's peace, reflected at once." },
    "cg_order_throne":   { "path": "cg/order_throne.webp",   "w": 1920, "h": 1080, "tags": ["event", "gallery", "ending"], "_note": "Order ending — you ascend as the new administrator of a pristine system." },
    "cg_chaos_collapse": { "path": "cg/chaos_collapse.webp", "w": 1920, "h": 1080, "tags": ["event", "gallery", "ending"], "_note": "Chaos ending — the system tears itself apart in colour and noise." },
    "cg_shelter_sleep":  { "path": "cg/shelter_sleep.webp",  "w": 1920, "h": 1080, "tags": ["event", "gallery", "ending"], "_note": "Shelter ending — you lie down inside the memory and never wake." },
    "cg_awakening":      { "path": "cg/awakening.webp",      "w": 1920, "h": 1080, "tags": ["event", "gallery"], "_note": "Waking in the pod; a centenarian waits at the bedside." },
    "cg_real_city":      { "path": "cg/real_city.webp",      "w": 1920, "h": 1080, "tags": ["event", "gallery"], "_note": "The window onto a chaotic, real, unrecommended city." }
  },

