{
  "gvnf": "1.0",
  "id": "s04b_calibration",
  "kind": "adhoc",
  "_note": "镜廊校准终端 — an ADHOC scene (script-standard §14). The Mirror Gallery runs a custom-styled 'calibration terminal' on the player: a developer-supplied module renders its own layout/interactions (a profiling quiz), then writes the three lean variables + saw_truth back and takes a declared exit. `call`ed from s04; the `done` exit returns to resume s04, while `skip` (the player refusing to be profiled) jumps straight to the decision. `fallback` keeps the game completable on any runtime that can't run the module.",
  "adhoc": {
    "module": "adhoc/calibration.js",
    "style": "adhoc/calibration.css",
    "entry": "mount",
    "title": "@s04cal.title",
    "params": {
      "weight": 1,
      "probes": [
        { "q": "@s04cal.q1", "a": [
          { "t": "@s04cal.q1.order",   "lean": "order" },
          { "t": "@s04cal.q1.chaos",   "lean": "chaos" },
          { "t": "@s04cal.q1.shelter", "lean": "shelter" }
        ] },
        { "q": "@s04cal.q2", "a": [
          { "t": "@s04cal.q2.order",   "lean": "order" },
          { "t": "@s04cal.q2.chaos",   "lean": "chaos" },
          { "t": "@s04cal.q2.shelter", "lean": "shelter" }
        ] },
        { "q": "@s04cal.q3", "a": [
          { "t": "@s04cal.q3.order",   "lean": "order" },
          { "t": "@s04cal.q3.chaos",   "lean": "chaos" },
          { "t": "@s04cal.q3.shelter", "lean": "shelter" }
        ] }
      ]
    },
    "reads": ["order_lean", "chaos_lean", "shelter_lean"],
    "writes": ["order_lean", "chaos_lean", "shelter_lean", "saw_truth"],
    "exits": [
      { "id": "done", "return": true },
      { "id": "skip", "jump": "s04_mirror_gallery#decide", "set": { "saw_truth": true } }
    ],
    "fallback": { "exit": "done", "set": { "saw_truth": true } }
  }
}
