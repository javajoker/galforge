{
  "gvnf": "1.0",
  "id": "s06_echo",
  "stageMode": "auto",
  "cast": ["order"],
  "_note": "结局 回声 (true ending, reached only via Refuse). Wake in the pod; ORDER's system-image dissolves to the centenarian via an outfit change (system -> elder); his confession; the turn to the real city. Ends refuse_end.",
  "script": [
    { "bg": "pod_room", "transition": { "type": "fade", "duration": 1500 } },
    { "bgm": "bgm_reality", "fade": 1800 },
    { "se": "se_pod" },

    { "cg": "cg_awakening", "transition": "fade" },
    { "narrate": "@s06.wake.1" },
    { "narrate": "@s06.wake.2" },
    { "cg": null },

    { "show": "order", "at": "center", "outfit": "system", "face": "neutral", "transition": "dissolve" },
    { "say": "order", "id": "s06_001", "text": "@s06.order.001", "face": "neutral", "voice": "auto" },
    { "outfit": "order", "to": "elder", "transition": { "type": "ripple", "duration": 1100 } },
    { "narrate": "@s06.reveal" },

    { "say": "order", "id": "s06_002", "text": "@s06.order.002", "face": "sad" },
    { "say": "order", "id": "s06_003", "text": "@s06.order.003", "face": "neutral" },
    { "say": "order", "id": "s06_004", "text": "@s06.order.004", "face": "sad" },
    { "say": "order", "id": "s06_005", "text": "@s06.order.005", "face": "sad", "voice": "auto" },

    { "narrate": "@s06.turn" },
    { "hide": "order", "transition": "fade" },

    { "cg": "cg_real_city", "transition": "dissolve" },
    { "narrate": "@s06.city.1" },
    { "narrate": "@s06.city.2" },
    { "narrate": "@s06.city.3" },
    { "narrate": "@s06.city.4" },

    { "end": "refuse_end" }
  ]
}
