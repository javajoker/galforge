{
  "gvnf": "1.0",
  "id": "s03_shelter",
  "stageMode": "auto",
  "cast": ["shelter"],
  "_note": "第三章 庇护. SHELTER reveals the photo is a real, deleted memory + the surface truth of ECHO. Minor choice tunes shelter_lean and sets saw_truth. Leads to s04.",
  "script": [
    { "bg": "memory_museum", "transition": { "type": "ripple", "duration": 1100 } },
    { "bgm": "bgm_memory", "fade": 1600 },

    { "narrate": "@s03.intro" },
    { "narrate": "@s03.museum" },

    { "show": "shelter", "at": "left", "outfit": "gown", "face": "neutral", "transition": "dissolve" },
    { "say": "shelter", "id": "s03_001", "text": "@s03.shelter.001", "face": "smile", "voice": "auto" },
    { "say": "shelter", "id": "s03_002", "text": "@s03.shelter.002", "face": "neutral" },

    { "closeup": "memory_shard", "caption": "@s03.shard.caption", "zoom": 1.3, "dim": 0.7, "transition": "dissolve" },
    { "wait": 600 },
    { "closeup": null },

    { "cg": "cg_photo_1999", "transition": { "type": "ripple", "duration": 800 } },
    { "say": "shelter", "id": "s03_003", "text": "@s03.shelter.003", "face": "sad" },
    { "cg": null, "transition": { "type": "ripple", "duration": 700 } },

    { "narrate": "@s03.truth.1" },
    { "narrate": "@s03.truth.2" },
    { "say": "shelter", "id": "s03_004", "text": "@s03.shelter.004", "face": "worried" },
    { "say": "shelter", "id": "s03_005", "text": "@s03.shelter.005", "face": "sad", "voice": "auto" },
    { "set": { "saw_truth": true } },

    { "choice": "@choice.truth.prompt", "id": "truth", "options": [
      { "text": "@choice.truth.opt_lost", "set": { "shelter_lean": "+1" },                          "jump": "#lost" },
      { "text": "@choice.truth.opt_warm", "set": { "shelter_lean": "+2" },                          "jump": "#warm" },
      { "text": "@choice.truth.opt_who",  "set": { "shelter_lean": "+1", "aegis_revealed": true },  "jump": "#who" }
    ] },

    { "label": "lost" },
    { "say": "shelter", "id": "s03_006", "text": "@s03.shelter.lost", "face": "sad" },
    { "say": "shelter", "id": "s03_009", "text": "@s03.shelter.lost2", "face": "worried" },
    { "jump": "#after" },

    { "label": "warm" },
    { "say": "shelter", "id": "s03_007", "text": "@s03.shelter.warm", "face": "smile", "voice": "auto" },
    { "say": "shelter", "id": "s03_010", "text": "@s03.shelter.warm2", "face": "smile" },
    { "jump": "#after" },

    { "label": "who" },
    { "say": "shelter", "id": "s03_008", "text": "@s03.shelter.who1", "face": "sad", "voice": "auto" },
    { "say": "shelter", "id": "s03_011", "text": "@s03.shelter.who2", "face": "sad" },
    { "jump": "#after" },

    { "label": "after" },
    { "narrate": "@s03.outro" },
    { "jump": "s04_mirror_gallery" }
  ]
}
