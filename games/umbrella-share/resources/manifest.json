    "street_evening": { "path": "bg/street_evening.webp", "w": 1920, "h": 1080 }
  },

  "cg": {
    "cg_cover":           { "path": "cg/cover.webp",           "w": 1920, "h": 1080, "tags": ["gallery"] },
