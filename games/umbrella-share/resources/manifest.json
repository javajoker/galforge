        "sad":       { "path": "char/shizuku/face/sad.png",       "w": 300, "h": 320, "offset": { "x": 0, "y": 120 } },
        "surprised": { "path": "char/shizuku/face/surprised.png", "w": 300, "h": 320, "offset": { "x": 0, "y": 120 } }
